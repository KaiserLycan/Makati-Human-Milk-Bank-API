<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: 'Helvetica Neue', Arial, sans-serif; margin: 0; color: #333; }
        .header { text-align: center; border-bottom: 3px solid #005f73; padding-bottom: 10px; margin-bottom: 20px; }
        .header h1 { margin: 0; color: #005f73; font-size: 24px; }
        .header p { margin: 5px 0 0 0; color: #666; font-size: 14px; }
        .summary-box { background-color: #f8f9fa; padding: 15px; border-left: 5px solid #0a9396; margin-bottom: 20px; }
        .summary-box p { margin: 5px 0; font-size: 14px; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #005f73; color: white; text-transform: uppercase; }
        tr:nth-child(even) { background-color: #f2f2f2; }
        .status-good { color: #2b9348; font-weight: bold; }
        .status-waste { color: #d62828; font-weight: bold; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Makati Human Milk Bank</h1>
        <h2>Collection Report</h2>
        <p><strong>Period:</strong> {{dateRange}}</p>
        <p><strong>Generated On:</strong> {{generatedDate}}</p>
    </div>

    <div class="summary-box">
        <p><strong>Total Volume Collected (Good):</strong> {{totalVolume}} ml</p>
        <p><strong>Total Volume Wasted:</strong> {{totalWaste}} ml</p>
    </div>

    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Donor DTN</th>
                <th>Program</th>
                <th>Volume (ml)</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            {{#each records}}
            <tr>
                <td>{{this.date}}</td>
                <td>{{this.dtn}}</td>
                <td>{{this.program}}</td>
                <td>{{this.volume_ml}}</td>
                <td class="{{#if this.isGood}}status-good{{else}}status-waste{{/if}}">{{this.status}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</body>
</html>
        "@babel/preset-env": "^7.29.7",
        "@eslint/js": "^10.0.1",
        "@jest/globals": "^29.7.0",
        "@prisma/language-server": "^31.11.0",
        "@types/express": "^5.0.6",
        "@types/node": "^25.9.3",
        "babel-jest": "^29.7.0",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-jest": "^29.15.2",
        "globals": "^17.6.0",
        "husky": "^9.1.7",

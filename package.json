        "lint-staged": "^15.2.11",
        "nodemon": "^3.1.14",
        "prettier": "^3.3.2",
        "ts-jest": "^29.1.2"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    },
    "jest": {
        "preset": "ts-jest/presets/default-esm",
        "transform": {
            "^.+\\.m?js$": "babel-jest"
        },
        "moduleFileExtensions": [
            "js",
            "mjs",
            "ts"
        ],
        "testEnvironment": "node",
        "testTimeout": 10000
    }

        "cross-env": "^10.1.0",
        "date-fns": "^4.4.0",
        "deepmerge-ts": "^7.1.5",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.0",
        "handlebars": "^4.7.9",
        "helmet": "^8.0.0",
        "ioredis": "^5.11.0",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.11.0",
        "multer": "^2.1.1",

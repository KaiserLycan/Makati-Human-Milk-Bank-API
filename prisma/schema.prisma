generator client {
  provider        = "prisma-client-js"
  output          = "../db/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model audit_log {
  log_id           Int       @id @default(autoincrement())
  modified_by      String    @db.Uuid
  action_performed String    @db.VarChar
  table_name       String    @db.VarChar
  old_data         Json?
  new_data         Json?
  performed_at     DateTime? @default(now()) @db.Timestamp(6)
  user             user      @relation(fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model beneficiary {
  bid                    Int                 @id @default(autoincrement())
  name                   String              @db.VarChar
  caregiver              String              @db.VarChar
  caregiver_email        String              @unique @db.VarChar
  caregiver_phone        String              @db.VarChar
  birth_date             DateTime            @db.Date
  weight_kg              Decimal             @db.Decimal(5, 2)
  feeding_requirement_ml Decimal             @db.Decimal(5, 2)
  profile                Json
  joined_date            DateTime?           @default(now()) @db.Date
  application_status     application_status? @default(pending)
  account_status         account_status?     @default(active)
  created_at             DateTime?           @default(now()) @db.Timestamp(6)
  modified_at            DateTime?           @default(now()) @db.Timestamp(6)
  modified_by            String              @db.Uuid
  user                   user                @relation(fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  request                request[]
}

model donor {
  dtn                Int                 @id @default(autoincrement())
  name               String              @db.VarChar
  email              String              @unique @db.VarChar
  phone              String              @db.VarChar
  birth_date         DateTime            @db.Date
  profile            Json
  joined_date        DateTime?           @default(now()) @db.Date
  application_status application_status? @default(pending)
  account_status     account_status?     @default(active)
  created_at         DateTime?           @default(now()) @db.Timestamp(6)
  modified_at        DateTime?           @default(now()) @db.Timestamp(6)
  modified_by        String              @db.Uuid
  user               user                @relation(fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  raw_milk           raw_milk[]
}

model request {
  rid              Int               @id @default(autoincrement())
  bid              Int
  hospital         String?           @db.VarChar
  requested_vol_ml Decimal           @db.Decimal(7, 2)
  requested_date   DateTime?         @default(dbgenerated("CURRENT_DATE")) @db.Date
  request_status   request_status?   @default(waiting)
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  modified_at      DateTime?         @default(now()) @db.Timestamp(6)
  modified_by      String            @db.Uuid
  beneficiary      beneficiary       @relation(fields: [bid], references: [bid], onDelete: NoAction, onUpdate: NoAction)
  user             user              @relation(fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  request_bottles  request_bottles[]

  @@index([requested_date, created_at], map: "idx_request_allocation_queue", where: raw("(request_status = 'waiting'::request_status)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pasteurized_milk {
  btl_id                                   Int                      @id @default(autoincrement())
  pid                                      Int
  processed_by                             String?                  @db.Uuid
  batch_number                             Int
  bottle_sequence_number                   Int
  volume_ml                                Decimal                  @db.Decimal(7, 2)
  bottle                                   bottle_type?             @default(ameda)
  processed_date                           DateTime?                @default(dbgenerated("CURRENT_DATE")) @db.Date
  expiration_date                          DateTime                 @db.Date
  mbt_status                               test_status?             @default(pending)
  dispense_status                          pasteurized_milk_status? @default(available)
  milk_status                              milk_status?             @default(good)
  remarks                                  String?                  @db.VarChar(500)
  created_at                               DateTime?                @default(now()) @db.Timestamp(6)
  modified_at                              DateTime?                @default(now()) @db.Timestamp(6)
  modified_by                              String                   @db.Uuid
  user_pasteurized_milk_modified_byTouser  user                     @relation("pasteurized_milk_modified_byTouser", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  pool_milk                                pool_milk                @relation(fields: [pid], references: [pid], onDelete: NoAction, onUpdate: NoAction)
  user_pasteurized_milk_processed_byTouser user?                    @relation("pasteurized_milk_processed_byTouser", fields: [processed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  request_bottles                          request_bottles[]

  @@index([expiration_date, created_at], map: "idx_milk_fefo_queue", where: raw("((dispense_status = 'available'::pasteurized_milk_status) AND (milk_status = 'good'::milk_status) AND (mbt_status = 'pass'::test_status))"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pool_milk {
  pid                              Int                @id @default(autoincrement())
  pooled_by                        String             @db.Uuid
  pooled_date                      DateTime?          @default(dbgenerated("CURRENT_DATE")) @db.Date
  expiration_date                  DateTime           @db.Date
  expected_volume_ml               Decimal            @db.Decimal(7, 2)
  actual_volume_ml                 Decimal            @db.Decimal(7, 2)
  qat_status                       test_status?       @default(pending)
  milk_status                      milk_status?       @default(good)
  remarks                          String?            @db.VarChar(500)
  created_at                       DateTime?          @default(now()) @db.Timestamp(6)
  modified_at                      DateTime?          @default(now()) @db.Timestamp(6)
  modified_by                      String             @db.Uuid
  pasteurized_milk                 pasteurized_milk[]
  user_pool_milk_modified_byTouser user               @relation("pool_milk_modified_byTouser", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  user_pool_milk_pooled_byTouser   user               @relation("pool_milk_pooled_byTouser", fields: [pooled_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  raw_milk                         raw_milk[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model raw_milk {
  ctn                              Int                 @id @default(autoincrement())
  dtn                              Int
  pid                              Int?
  program                          collection_program? @default(WI)
  hospital                         String?             @db.VarChar
  health_center                    String?             @db.VarChar
  volume_ml                        Decimal             @db.Decimal(7, 2)
  collected_by                     String?             @db.Uuid
  collection_date                  DateTime?           @default(dbgenerated("CURRENT_DATE")) @db.Date
  expiration_date                  DateTime            @db.Date
  pickup_date                      DateTime?           @default(dbgenerated("CURRENT_DATE")) @db.Date
  qat_status                       test_status?        @default(pending)
  milk_status                      milk_status?        @default(good)
  remarks                          String?             @db.VarChar(500)
  created_at                       DateTime?           @default(now()) @db.Timestamp(6)
  modified_at                      DateTime?           @default(now()) @db.Timestamp(6)
  modified_by                      String              @db.Uuid
  user_raw_milk_collected_byTouser user?               @relation("raw_milk_collected_byTouser", fields: [collected_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  donor                            donor               @relation(fields: [dtn], references: [dtn], onDelete: NoAction, onUpdate: NoAction)
  user_raw_milk_modified_byTouser  user                @relation("raw_milk_modified_byTouser", fields: [modified_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  pool_milk                        pool_milk?          @relation(fields: [pid], references: [pid], onDelete: NoAction, onUpdate: NoAction)
}

model request_bottles {
  rid              Int
  btl_id           Int
  pasteurized_milk pasteurized_milk @relation(fields: [btl_id], references: [btl_id], onDelete: Cascade, onUpdate: NoAction)
  request          request          @relation(fields: [rid], references: [rid], onDelete: Cascade, onUpdate: NoAction)

  @@id([rid, btl_id])
}

model user {
  user_id                                              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role                                                 user_role?         @default(staff)
  name                                                 String             @db.VarChar
  email                                                String             @unique @db.VarChar
  phone                                                String             @db.VarChar
  password                                             String             @db.VarChar
  status                                               account_status?    @default(active)
  created_at                                           DateTime?          @default(now()) @db.Timestamp(6)
  modified_at                                          DateTime?          @default(now()) @db.Timestamp(6)
  modified_by                                          String?            @db.Uuid
  audit_log                                            audit_log[]
  beneficiary                                          beneficiary[]
  donor                                                donor[]
  pasteurized_milk_pasteurized_milk_modified_byTouser  pasteurized_milk[] @relation("pasteurized_milk_modified_byTouser")
  pasteurized_milk_pasteurized_milk_processed_byTouser pasteurized_milk[] @relation("pasteurized_milk_processed_byTouser")
  pool_milk_pool_milk_modified_byTouser                pool_milk[]        @relation("pool_milk_modified_byTouser")
  pool_milk_pool_milk_pooled_byTouser                  pool_milk[]        @relation("pool_milk_pooled_byTouser")
  raw_milk_raw_milk_collected_byTouser                 raw_milk[]         @relation("raw_milk_collected_byTouser")
  raw_milk_raw_milk_modified_byTouser                  raw_milk[]         @relation("raw_milk_modified_byTouser")
  request                                              request[]
  user                                                 user?              @relation("userTouser", fields: [modified_by], references: [user_id], onUpdate: NoAction)
  other_user                                           user[]             @relation("userTouser")
}

enum request_status {
  waiting
  allocated
  completed
  canceled
}

enum test_status {
  pending
  pass
  fail
}

enum user_role {
  staff
  manager
}

enum account_status {
  active
  inactive
}

enum application_status {
  pending
  approved
  rejected
}

enum bottle_type {
  ameda
  korea
  red_cap
}

enum collection_program {
  WI
  MA
  MW
  ST
}

enum milk_status {
  good
  contaminated
  expired
  discarded
}

enum pasteurized_milk_status {
  reserved
  available
  dispensed
}
